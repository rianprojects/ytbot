{
  "name": "ytbot",
  "version": "1.0.0",
  "description": "YouTube Downloader - download video & audio from YouTube",
  "main": "electron/main.js",
  "author": "rianprojects",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build:client": "cd client && npm run build",
    "build:win": "npm run build:client && electron-builder --win",
    "build:dir": "npm run build:client && electron-builder --win --dir"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.ytbot.app",
    "productName": "YouTube Downloader",
    "directories": {
      "output": "dist-installer"
    },
    "files": [
      "electron/**/*",
      "server/**/*",
      "!server/server.log",
      "!server/tray.ps1",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "client/dist",
        "to": "client/dist"
      }
    ],
    "win": {
      "icon": "electron/build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "YouTube Downloader",
      "installerIcon": "electron/build/icon.ico",
      "uninstallerIcon": "electron/build/icon.ico",
      "installerHeaderIcon": "electron/build/icon.ico"
    }
  }
}
